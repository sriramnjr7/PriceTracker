{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 15,
      "regions": ["bom1"]
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py?_vercel_path=$1"
    }
  ]
}
