[Unit]
Description=RailRadar Autonomous Commute Intelligence Daemon (@SriTrainBot)
Documentation=https://github.com/sriram/PriceTracker
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=srira
WorkingDirectory=/home/srira/PriceTracker
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/srira/PriceTracker/.env
ExecStart=/usr/bin/python3 /home/srira/PriceTracker/rail_daemon.py
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=30

# Logging & Resource Protection
StandardOutput=journal
StandardError=journal
SyslogIdentifier=railradar
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
